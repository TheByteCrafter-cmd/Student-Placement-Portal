# Environment Variable Template
# Copy to .env for local development - DO NOT commit real secrets to Git

# Application Environment
NODE_ENV=development
PORT=5000

# Frontend CORS URL
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_portal?schema=public
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=placement_portal

# Phase 2 Authentication & Security Configurations
JWT_SECRET=your_strong_jwt_secret_key_here
JWT_EXPIRES_IN=1d
COOKIE_SECRET=your_cookie_signing_secret_here

# Admin Bootstrap Credentials (Placeholders Only - Set in your local .env file)
ADMIN_EMAIL=admin@your-institution.edu
ADMIN_PASSWORD=your_secure_admin_password_here
